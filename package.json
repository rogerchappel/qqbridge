{
  "name": "qqbridge",
  "version": "0.1.0",
  "description": "Local-first OpenClaw QQ adapter test kit with safe fixture replay.",
  "type": "module",
  "main": "./src/index.js",
  "bin": {
    "qqbridge": "./bin/qqbridge.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src",
    "fixtures",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check-js.mjs && node scripts/check-fixtures.mjs",
    "build": "node scripts/build.mjs",
    "smoke": "bash scripts/smoke.sh",
    "package:smoke": "npm pack --dry-run",
    "release:check": "npm test && npm run check && npm run build && npm run smoke && npm run package:smoke"
  },
  "keywords": [
    "openclaw",
    "qq",
    "adapter",
    "fixtures",
    "replay",
    "local-first"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
